#!/bin/bash
# Stand-in for curl, used by tests/run.sh so the suite is offline and
# deterministic. Serves the recorded MusicBrainz and Discogs responses in
# tests/fixtures/ (mounted at $FIXTURES) and generated cover images. It answers
# with real HTTP status codes: -w '%{http_code}' prints one, and -f turns an
# error status into exit 22, like curl.
#   FAKE_MB_EMPTY=1  MusicBrainz knows nothing (so the Discogs fallback runs)
#   FAKE_MB_503=1    every MusicBrainz request answers 503
fx="${FIXTURES:-/fixtures}"
url=""; out=""; wfmt=""; fail=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    -o) out="$2"; shift 2 ;;
    -w) wfmt="$2"; shift 2 ;;
    -A|--max-time|--data-urlencode|-H) shift 2 ;;
    http*) url="$1"; shift ;;
    -*f*) fail=1; shift ;;
    *) shift ;;
  esac
done
body="$(mktemp)"; code=404
serve() { code=200; cat "$1" > "$body"; }
cover() { ffmpeg -v error -y -f lavfi -i "color=c=$1:s=64x64" -frames:v 1 -f mjpeg "$body" && code=200; }

if [[ -n "${FAKE_MB_503:-}" && "$url" == https://musicbrainz.org/* ]]; then
  code=503
else
  case "$url" in
    https://musicbrainz.org/ws/2/release/*)
      f="$fx/release-${url##*/release/}.json"; [[ -f "$f" ]] && serve "$f" ;;
    https://musicbrainz.org/ws/2/release)
      if [[ -n "${FAKE_MB_EMPTY:-}" ]]; then echo '{"releases":[]}' > "$body"; code=200
      else serve "$fx/search-barcode.json"; fi ;;
    https://musicbrainz.org/ws/2/discid/*) code=404 ;;     # a disc MusicBrainz has never seen
    https://api.discogs.com/database/search) serve "$fx/discogs-search-barcode.json" ;;
    https://api.discogs.com/releases/*)
      f="$fx/discogs-release-${url##*/releases/}.json"; [[ -f "$f" ]] && serve "$f" ;;
    https://i.discogs.com/*) cover 0x993366 ;;
    https://coverartarchive.org/release/*/front-1200) cover 0x336699 ;;
  esac
fi

if [[ $code == 200 ]]; then
  if [[ -n "$out" ]]; then mv "$body" "$out"; else cat "$body"; rm -f "$body"; fi
else
  rm -f "$body"; [[ -n "$out" ]] && : > "$out"
fi
[[ -n "$wfmt" ]] && printf '%s' "$code"
if [[ $code != 200 && $fail == 1 ]]; then exit 22; fi
exit 0
