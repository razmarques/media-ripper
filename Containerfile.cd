# Self-contained image for running cd-ripper.sh: secure CD ripping (cyanrip),
# FLAC (reference encoder) and AAC (FDK-AAC) encoders, plus the script itself
# baked in as the entrypoint. One throwaway container per cd-ripper.sh run.
#
# Build:
#   docker build -t media-ripper-cd:latest -f Containerfile.cd .
#
# Commands: rip | match | update | encode | run (see --help). Examples:
#   docker run --rm --device=/dev/sr0 -v "$MUSIC_ROOT":/music \
#       media-ripper-cd:latest run --format aac --barcode 042281827129
#   docker run --rm -v "$MUSIC_ROOT":/music media-ripper-cd:latest \
#       update /music/RIP/<id> --barcode 042281827129 --apply
#   docker run --rm --network none -v "$PWD/inputs":/in:ro -v "$MUSIC_ROOT":/music \
#       media-ripper-cd:latest run "/in/Artist - Album [WAV]" --format aac
#
# Disc commands need --device (the drive) and network (MusicBrainz and
# AccurateRip), unlike the DVD image which runs offline. match/update with an
# identifier need network too. Tests: tests/run.sh.

FROM docker.io/library/ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
# fdkaac converts tag strings from the locale charset; without UTF-8 here,
# accented characters (e.g. "Cárcere") are mangled to "??".
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8

# fdkaac lives in multiverse (FDK-AAC is not free software by distro rules).
RUN apt-get update \
 && apt-get install -y --no-install-recommends software-properties-common \
 && add-apt-repository -y multiverse \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      cyanrip flac fdkaac ffmpeg curl jq ca-certificates atomicparsley \
 && rm -rf /var/lib/apt/lists/*

COPY cd-ripper.sh /usr/local/bin/cd-ripper.sh
COPY lib/ /usr/local/lib/cd-ripper/
RUN chmod +x /usr/local/bin/cd-ripper.sh

ENTRYPOINT ["/usr/local/bin/cd-ripper.sh"]
